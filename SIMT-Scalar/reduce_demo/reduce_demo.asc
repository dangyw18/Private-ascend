/* !
 * \file reduce_demo.asc
 * \brief 使用 ccec 编译器内建指令（vdup/vlds/vcadd/vadd/vsts）实现向量归约求和，
 *        并借助 ccec 内建 get_sys_cnt() 统计各阶段（GM->UB 搬运 / reduce 计算 /
 *        UB->GM 搬出 / kernel 总耗时）的硬件 cycle 数。
 *
 * 代码逻辑已在 Ascend 服务器上实测验证通过（test pass!），本文件只优化注释，
 * 不修改任何代码逻辑。
 *
 * 实现要点：
 *  1. vector 指令（vlds/vadd/vcadd/vsts 等）必须放在独立的 __simd_vf__ 函数中；
 *     get_sys_cnt() 等标量操作留在 __vector__ kernel 主体（标量上下文），二者
 *     不可混写，否则后端报 "Do not know how to split the result of this operator!"。
 *  2. get_sys_cnt() 是 ccec 编译器内建，必须用 __attribute__((noinline)) 包装，
 *     防止 Release(-O2/-O3) 下编译器做 CSE/常量折叠导致各时间戳相等。
 *  3. get_sys_cnt() 走 PIPE_S 标量流水线，与被测的 PIPE_MTE2/PIPE_V/PIPE_MTE3
 *     异步；每次读计数器前必须插入对应流水线到 PIPE_S 的同步
 *     （asc_sync_notify(from, PIPE_S, ...) + asc_sync_wait(from, PIPE_S, ...)），
 *     否则 PIPE_S 可能越过下游同步提前执行，cycle 差值偏小甚至为 0。
 *  4. 本样例提供 5 种归约算法（cce1~cce5），kernel 中实际调用的是 cce5 系列
 *     （cce5_1 按 repeat 归约出部分和，cce5_2 将部分和向量二次归约得到最终和），
 *     cce1~cce4 作为算法对比保留在文件中。
 */

#include <cstdint>
#include <vector>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

// 输入总长度（float 元素个数），4096 个 float（16KB），单轮即可全部搬入 UB
constexpr std::uint32_t TOTAL_LENGTH = 4096;
constexpr std::uint32_t NUM_BLOCKS = 1;
constexpr std::uint32_t BLK_NUM = 1;

// VF 差分测试开关：
//   0：保持原始 cce5_1 两次 + cce5_2 两次的演示逻辑；
//   1：完整的 cce3 VF 只调用一次，得到 T1；
//   2：同一个 cce3 VF 连续调用两次，得到 T2。
// CMake 通过 -DREDUCE_VF_CALLS=<0|1|2> 在编译期设置，避免运行时循环本身
// 给 PIPE_S/PIPE_V 引入额外开销。
#ifndef REDUCE_VF_CALLS
#define REDUCE_VF_CALLS 0
#endif

static_assert(REDUCE_VF_CALLS >= 0 && REDUCE_VF_CALLS <= 2,
              "REDUCE_VF_CALLS must be 0, 1, or 2");

// 向上取整除法：ceil(numerator / denominator)
__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}
// 输出对齐长度：8 个 float（32B），满足 UB/GM 搬运的 32B 对齐要求
constexpr uint32_t OUT_ALIGN_SIZE = 8;

// 使用 ccec 内建指令实现归约：vdup/vlds/vcadd/vadd/vsts

// 阻止编译器对 get_sys_cnt() 做 CSE 常量折叠优化：
// get_sys_cnt 是 ccec 编译器内建（走 PIPE_S），noinline 强制每次调用独立执行，
// 否则 Release(-O2/-O3) 下多次调用会被合并，导致各时间戳相等、cycle 差值为 0
__attribute__((noinline)) __aicore__ int64_t asc_get_system_cycle_safe()
{
    return get_sys_cnt();
}

// algorithm 1 309 cycles: 运行 70 cycles 启动vf时间 230 cycles
// 思路：每次循环展开 4 个向量，先 vadd 两两合并（4 -> 2 -> 1 个向量），
//       再 vcadd 对合并后的向量做单向量归约，最后 vadd 累加到 acc_reg
__simd_vf__ inline void reduce_sum_vf_cce1(
    __ubuf__ float* x_local, __ubuf__ float* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask;
    vector_float src_reg1;
    vector_float src_reg2;
    vector_float src_reg3;
    vector_float src_reg4;
    vector_float mid_reg1;
    vector_float mid_reg2;
    vector_float mid_reg3;
    // pset 生成 mask
    vector_float dst_reg;
    vector_float acc_reg;
    // vdup: 将标量 0.0f 广播到 acc_reg 各通道（清零累加寄存器）
    vdup(acc_reg, 0.0f, vmask, MODE_ZEROING);
    // pset_b32: 生成全 1 掩码（PAT_ALL 表示所有通道有效）
    vmask = pset_b32(PAT_ALL);
    for (uint16_t i = 0; i < repeat_time; i+=4) {
        // vlds: 从 UB 加载一个向量到寄存器（NORM: 常规整向量加载，offset 按元素计）
        vlds(src_reg1, x_local + i * one_rep_size, 0, NORM);
        vlds(src_reg2, x_local + (i + 1) * one_rep_size, 0, NORM);
        vlds(src_reg3, x_local + (i + 2) * one_rep_size, 0, NORM);
        vlds(src_reg4, x_local + (i + 3) * one_rep_size, 0, NORM);
        // vadd: 向量逐通道相加，先两两合并
        vadd(mid_reg1, src_reg1, src_reg2, vmask);
        vadd(mid_reg2, src_reg3, src_reg4, vmask);
        vadd(mid_reg3, mid_reg1, mid_reg2, vmask);
        // vcadd: 单向量内归约（交叉相加），MODE_ZEROING 下非归约通道清零
        vcadd(dst_reg, mid_reg3, vmask, MODE_ZEROING);
        // vadd: 部分和累加到 acc_reg
        vadd(acc_reg, acc_reg, dst_reg, vmask);
    }
    // vsts: 寄存器写回UB（NORM_B32: 常规 32B 对齐整向量存储）
    vsts(acc_reg, y_local, 0, NORM_B32, vmask);
}



// algorithm 2 410 cycles: 运行 180 cycles 启动vf时间 230 cycles
// 思路：每个向量单独 vcadd 归约后 vadd 累加；用 plt_b32 按剩余元素数
//       更新部分掩码（POST_UPDATE 自动递减 remain），处理尾部非整向量
__simd_vf__ inline void reduce_sum_vf_cce2(
    __ubuf__ float* x_local, __ubuf__ float* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask;
    vector_float src_reg;
    vector_float dst_reg;
    vector_float acc_reg;
    uint32_t remain = data_len;
    // pset 生成 mask：先全 1 掩码
    vmask = pset_b32(PAT_ALL);
    // vdup 做 broadcast：清零累加寄存器
    vdup(acc_reg, 0.0f, vmask, MODE_ZEROING);
    for (uint16_t i = 0; i < repeat_time; ++i) {
        // plt_b32: 按剩余元素更新部分mask（POST_UPDATE: 生成后自动扣减 remain）
        vmask = plt_b32(remain, POST_UPDATE);
        // vlds: 从UB加载一个向量到寄存器
        vlds(src_reg, x_local + i * one_rep_size, 0, NORM);
        // vcadd: 向量归约操作
        vcadd(dst_reg, src_reg, vmask, MODE_ZEROING);
        // vadd: 部分累加到 acc_reg
        vadd(acc_reg, acc_reg, dst_reg, vmask);
    }
    // vsts: 寄存器写回UB
    vsts(acc_reg, y_local, 0, NORM_B32, vmask);
}


// algorithm 3 339 cycles: 运行 100 cycles 启动vf时间 239 cycles
// 思路：每轮 vcadd 归约后只把部分和（第 0 通道，ONEPT_B32 单点存储）写回
//       y_local[i]；循环结束后 mem_bar(VST_VLD) 保证写回可见，再整向量加载
//       y_local 做第二次 vcadd，得到最终和写回 y_local
__simd_vf__ inline void reduce_sum_vf_cce3(
    __ubuf__ float* x_local, __ubuf__ float* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask_all = pset_b32(PAT_ALL);
    vector_bool vmask_one = pset_b32(PAT_VL1);
    vector_float src_reg;
    vector_float dst_reg;
    uint32_t remain = data_len;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        // vlds: 从UB加载一个向量到寄存器
        vlds(src_reg, x_local + i * one_rep_size, 0, NORM);
        // vcadd: 向量归约操作
        vcadd(dst_reg, src_reg, vmask_all, MODE_ZEROING);
        // vsts：寄存器写回UB（ONEPT_B32: 仅存储第 0 通道 1 个元素，PAT_VL1 掩码）
        vsts(dst_reg, y_local + i, 0, ONEPT_B32, vmask_one);
    }
    // mem_bar: 存储-加载屏障，确保上面所有 vsts 写回 UB 后再 vlds
    mem_bar(VST_VLD);
    vlds(src_reg, y_local, 0, NORM);
    vcadd(dst_reg, src_reg, vmask_all, MODE_ZEROING);
    vsts(dst_reg, y_local, 0, NORM_B32, vmask_all);
    mem_bar(VST_VLD);
}

// algorithm 4 338 cycles: 运行 70 cycles 启动vf时间 260 cycles
// 思路：同 cce3，但循环每次展开 2 个向量（双发 vlds/vcadd/vsts），
//       提高 PIPE_V 指令级并行，减少循环开销
__simd_vf__ inline void reduce_sum_vf_cce4(
    __ubuf__ float* x_local, __ubuf__ float* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask_all = pset_b32(PAT_ALL);
    vector_bool vmask_one = pset_b32(PAT_VL1);
    vector_float src_reg1, src_reg2;
    vector_float dst_reg1, dst_reg2;
    uint32_t remain = data_len;
    for (uint16_t i = 0; i < repeat_time; i+=2) {
        // vlds: 从UB加载一个向量到寄存器
        vlds(src_reg1, x_local + i * one_rep_size, 0, NORM);
        vlds(src_reg2, x_local + (i + 1) * one_rep_size, 0, NORM);
        // vcadd: 向量归约操作
        vcadd(dst_reg1, src_reg1, vmask_all, MODE_ZEROING);
        vcadd(dst_reg2, src_reg2, vmask_all, MODE_ZEROING);
        // vsts：寄存器写回UB
        vsts(dst_reg1, y_local + i, 0, ONEPT_B32, vmask_one);
        vsts(dst_reg2, y_local + i + 1, 0, ONEPT_B32, vmask_one);
    }
    // mem_bar: 确保部分和全部写回后再做二次归约
    mem_bar(VST_VLD);
    vlds(src_reg1, y_local, 0, NORM);
    vcadd(dst_reg1, src_reg1, vmask_all, MODE_ZEROING);
    vsts(dst_reg1, y_local, 0, NORM_B32, vmask_all);
    mem_bar(VST_VLD);
}


// algorithm 5 333 cycles: 运行 80 cycles 启动vf时间 250 cycles
// 思路：把 cce3 拆成两个函数 —— cce5_1 只做"部分和写回 y_local[i]"，
//       cce5_2 只做"整向量二次归约"，便于在 kernel 中灵活编排调用顺序
__simd_vf__ inline void reduce_sum_vf_cce5_1(
    __ubuf__ float* x_local, __ubuf__ float* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask_all = pset_b32(PAT_ALL);
    vector_bool vmask_one = pset_b32(PAT_VL1);
    vector_float src_reg;
    vector_float dst_reg;
    uint32_t remain = data_len;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        // vlds: 从UB加载一个向量到寄存器
        vlds(src_reg, x_local + i * one_rep_size, 0, NORM);
        // vcadd: 向量归约操作
        vcadd(dst_reg, src_reg, vmask_all, MODE_ZEROING);
        // vsts：寄存器写回UB（仅第 0 通道，即该向量的部分和）
        vsts(dst_reg, y_local + i, 0, ONEPT_B32, vmask_one);
    }
}

// cce5_2: 将 y_local 中的部分和向量整向量加载并做二次归约，得到最终和
__simd_vf__ inline void reduce_sum_vf_cce5_2(
    __ubuf__ float* x_local, __ubuf__ float* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask_all = pset_b32(PAT_ALL);
    vector_bool vmask_one = pset_b32(PAT_VL1);
    vector_float src_reg;
    vector_float dst_reg;
    // vlds: 整向量加载 y_local（部分和向量）
    vlds(src_reg, y_local, 0, NORM);
    // vcadd: 二次归约，得到最终和
    vcadd(dst_reg, src_reg, vmask_all, MODE_ZEROING);
    // vsts: 最终和写回 y_local 第 0 通道
    vsts(dst_reg, y_local, 0, NORM_B32, vmask_all);
}



// kernel 主体：GM->UB 搬运 -> reduce 计算 -> UB->GM 搬出，并用 get_sys_cnt 统计各阶段 cycle
__vector__ __global__ void reduce_custom_cce(__gm__ float* x, __gm__ float* y, __gm__ int64_t* cycles)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    // 各 block 处理输入的一段、输出对应的一段
    __gm__ float* x_gm = x + block_idx * block_length;
    __gm__ float* y_gm = y + block_idx * OUT_ALIGN_SIZE;

    // 本地 UB buffer（对齐声明，x_local 按块长，y_local 预留 64 float 空间）
    __ubuf__ float x_local[block_length];
    // __ubuf__ float y_local[OUT_ALIGN_SIZE];
    __ubuf__ float y_local[64];

    // 使用 cycle 统计周期数：t0 为起点（PIPE_S 自身指令，无需跨流水线同步）
    int64_t t0 = asc_get_system_cycle_safe();

    // GM->UB 搬运（PIPE_MTE2）
    asc_copy_gm2ub_align((__ubuf__ float*)x_local, x_gm, 1, block_length * sizeof(float), 0, 0, false, 0, 0, 0);
    // 数据依赖同步：PIPE_V 等待 PIPE_MTE2 完成（reduce 读 x_local）
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    // 计时依赖同步：PIPE_S 等待 PIPE_MTE2 完成（确保 t1 读到搬运完成后的计数器）
    asc_sync_notify(PIPE_MTE2, PIPE_S, EVENT_ID1);
    asc_sync_wait(PIPE_MTE2, PIPE_S, EVENT_ID1);

    int64_t t1 = asc_get_system_cycle_safe();

    // 向量长度（字节）/ float 大小 = 单向量元素数；repeat_time 为循环次数
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = ceil_division(block_length, one_rep_size);

    int64_t t2 = asc_get_system_cycle_safe();

    // reduce 计算（PIPE_V）。VF 差分实验必须满足：
    //   * 1-call 与 2-call 使用完全相同的 cce3 VF 和完全相同的参数；
    //   * t2/t3 与 PIPE_V->PIPE_S 同步位置保持不变；
    //   * 仅增加一次连续 VF 调用，其他代码不变。
    // 因此可建立近似线性模型 T(N) = F + N*R：
    //   R = T2 - T1，F = 2*T1 - T2。
    // F 是该计时区间的“固定开销”，包含 VF 启停/排空、同步和计时边界，
    // 不能在没有进一步基线实验时直接等同为纯 VF 启动时间。
#if REDUCE_VF_CALLS == 1
    reduce_sum_vf_cce3((__ubuf__ float*)x_local, (__ubuf__ float*)y_local,
                       block_length, one_rep_size, repeat_time);
#elif REDUCE_VF_CALLS == 2
    reduce_sum_vf_cce3((__ubuf__ float*)x_local, (__ubuf__ float*)y_local,
                       block_length, one_rep_size, repeat_time);
    reduce_sum_vf_cce3((__ubuf__ float*)x_local, (__ubuf__ float*)y_local,
                       block_length, one_rep_size, repeat_time);
#else
    // 原始 demo：cce5_1 两次（部分和写回），cce5_2 两次（二次归约）。
    reduce_sum_vf_cce5_1((__ubuf__ float*)x_local, (__ubuf__ float*)y_local, block_length, one_rep_size, repeat_time);
    reduce_sum_vf_cce5_1((__ubuf__ float*)x_local, (__ubuf__ float*)y_local, block_length, one_rep_size, repeat_time);
    reduce_sum_vf_cce5_2((__ubuf__ float*)x_local, (__ubuf__ float*)y_local, block_length, one_rep_size, repeat_time);
    reduce_sum_vf_cce5_2((__ubuf__ float*)x_local, (__ubuf__ float*)y_local, block_length, one_rep_size, repeat_time);
#endif
    // 数据依赖同步：PIPE_MTE3 等待 PIPE_V 完成（搬出读 y_local）
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    // 计时依赖同步：PIPE_S 等待 PIPE_V 完成（确保 t3 读到计算完成后的计数器）
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID1);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID1);

    int64_t t3 = asc_get_system_cycle_safe();

    // UB->GM 搬出（PIPE_MTE3）
    asc_copy_ub2gm_align(y_gm, (__ubuf__ float*)y_local, 1, OUT_ALIGN_SIZE * sizeof(float), 0, 0, 0);
    // 计时依赖同步：PIPE_S 等待 PIPE_MTE3 完成
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID1);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID1);

    int64_t t4 = asc_get_system_cycle_safe();

    cycles[0] = t1 - t0; // gm->ub time
    cycles[1] = t3 - t2; // reduce time
    cycles[2] = t4 - t0; // total time
    cycles[3] = t4 - t3; // ub->gm time
    asc_sync();
}

// host 侧：ACL 初始化 -> 数据搬入 -> kernel 启动 -> 结果/cycle 搬回 -> 资源释放
std::vector<float> kernel_reduce(std::vector<float>& x) {
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    constexpr uint32_t cycle_count = 4;
    uint32_t total_length = x.size();
    size_t input_byte_size = total_length * sizeof(float);
    size_t output_byte_size = num_blocks * OUT_ALIGN_SIZE * sizeof(float);
    int32_t device_id = 2;
    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* y_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;
    int64_t* cycles_host = nullptr;
    int64_t* cycles_device = nullptr;

    // ACL 运行时初始化并绑定设备
    aclInit(nullptr);
    aclrtSetDevice(device_id);

    // host/device 侧内存申请
    aclrtMallocHost((void**)(&y_host), output_byte_size);
    aclrtMallocHost((void**)(&cycles_host), cycle_count * sizeof(int64_t));
    aclrtMalloc((void**)&x_device, input_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, output_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cycles_device, cycle_count * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST);

    // host -> device 输入数据搬运
    aclrtMemcpy((uint8_t*)x_device, input_byte_size, x_host, input_byte_size, ACL_MEMCPY_HOST_TO_BUF_TO_DEVICE);

    // kernel 启动（<<<grid, block>>> 语法，1 个 block）
    reduce_custom_cce<<<num_blocks, 0>>>(x_device, y_device, cycles_device);
    aclrtSynchronizeDevice();

    // device -> host 结果与 cycle 统计搬运
    aclrtMemcpy(y_host, output_byte_size, (uint8_t*)y_device, output_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(cycles_host, cycle_count * sizeof(int64_t), (uint8_t*)cycles_device, cycle_count * sizeof(int64_t), ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<float> y((float*)y_host, (float*)(y_host + output_byte_size));


    std::cout << "Kernel cycle stats" << std::endl;
#if REDUCE_VF_CALLS > 0
    std::cout << " VF call count: " << REDUCE_VF_CALLS << std::endl;
#else
    std::cout << " VF call count: original cce5 sequence" << std::endl;
#endif
    std::cout << " GM->UB copy: " << cycles_host[0] << " cycles" << std::endl;
    std::cout << " reduce loop: " << cycles_host[1] << " cycles" << std::endl;
    std::cout << " UB->GM copy: " << cycles_host[3] << " cycles" << std::endl;
    std::cout << " kernel total: " << cycles_host[2] << " cycles" << std::endl;

    // 释放资源并复位设备
    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(cycles_device);
    aclrtFreeHost(y_host);
    aclrtFreeHost(cycles_host);

    aclrtResetDevice(device_id);
    aclFinalize();
    return y;
}

// 结果校验：host 侧对输出做浮点求和，与 golden 值比较（绝对/相对误差 <= 1e-4）
uint32_t verify_result(std::vector<float>& output, float golden_sum)
{
    float result = 0.0f;
    for (size_t i = 0; i < output.size(); ++i) {
        result += output[i];
    }
    std::cout << "Output sum: " << result << std::endl;
    std::cout << "Golden sum: " << golden_sum << std::endl;
    constexpr float eps = 1e-4f;
    float abs_error = std::abs(result - golden_sum);
    float rel_error = abs_error / std::abs(golden_sum);
    if (abs_error <= eps || rel_error <= eps) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<float> x(total_length);
    std::vector<float> golden(8);

    size_t x_file_size = 0;
    size_t golden_file_size = 0;
    // 读取输入数据与 golden 数据（二进制 float32 格式，由 scripts/gen_data.py 生成）
    if (!ReadFile("./input/input_x.bin", x_file_size, x.data(), total_length * sizeof(float))) {
        std::cout << "[Failed] Failed to read input data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", golden_file_size, golden.data(), 8 * sizeof(float))) {
        std::cout << "[Failed] Failed to read golden data file!" << std::endl;
        return 1;
    }

    std::vector<float> output = kernel_reduce(x);
    float golden_sum = golden[0];
    return verify_result(output, golden_sum);
}
