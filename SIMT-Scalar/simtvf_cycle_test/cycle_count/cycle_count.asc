/* !
 * \file cycle_count.asc
 * \brief 用 1-call/2-call 线性差分估算 SIMTVF 单次增量时间和固定开销。
 *
 * 与 cycle_count_demo/reduce_demo 一致：
 *   1. 只在 __vector__ 标量上下文调用 get_sys_cnt()；
 *   2. 使用 noinline 包装，避免多个计数器读取被优化合并；
 *   3. t1 前执行 PIPE_V -> PIPE_S 同步，保证 SIMTVF 已经完成。
 *
 * 两个独立编译版本只改变 VF_CALLS：
 *   T1 = 一次 SIMTVF 调用的计时区间
 *   T2 = 两次连续、相同 SIMTVF 调用的计时区间
 *   R  = T2 - T1
 *   F  = 2*T1 - T2
 *
 * F 是模型 T(k)=F+k*R 的固定项，可能包含首次切换、最终排空、同步和计时边界；
 * 在没有进一步拆分实验前，不把它直接命名为“纯启动时间”。
 */

#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#include "../simt_kernel/simt_kernel.h"

#ifndef SIMT_CASE
#define SIMT_CASE 1
#endif

#ifndef VF_CALLS
#define VF_CALLS 1
#endif

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t CYCLE_COUNT = 1;

static_assert(SIMT_CASE == 1 || SIMT_CASE == 2,
              "SIMT_CASE must be 1 or 2");
static_assert(VF_CALLS == 1 || VF_CALLS == 2,
              "VF_CALLS must be 1 or 2");

// 阻止 CCEC 在 -O2/-O3 下对多次 get_sys_cnt() 做 CSE/常量折叠。
__attribute__((noinline)) __aicore__ int64_t get_sys_cnt_safe()
{
    return get_sys_cnt();
}

__vector__ __global__ void simtvf_cycle_count(
    __gm__ float* a, __gm__ float* b, __gm__ float* c,
    __gm__ int64_t* cycles)
{
    asc_init();

    // t0 位于第一个 SIMTVF 调用之前，两个版本的起点完全相同。
    const int64_t t0 = get_sys_cnt_safe();

    // 两次调用版本不在调用之间插入同步，使其与 reduce_demo 的连续 VF
    // 差分方法一致；只有 VF_CALLS 是 1-call/2-call 两个二进制的变量。
#if SIMT_CASE == 1
    asc_vf_call<SimtCase1>(dim3{SIMT_THREADS, 1, 1}, a, b, c);
#if VF_CALLS == 2
    asc_vf_call<SimtCase1>(dim3{SIMT_THREADS, 1, 1}, a, b, c);
#endif
#else
    asc_vf_call<SimtCase2>(dim3{SIMT_THREADS, 1, 1}, a, b, c);
#if VF_CALLS == 2
    asc_vf_call<SimtCase2>(dim3{SIMT_THREADS, 1, 1}, a, b, c);
#endif
#endif

    // get_sys_cnt() 走 PIPE_S，SIMTVF 走 PIPE_V。必须让 PIPE_S 等待 PIPE_V，
    // 否则 t1 可能提前读取，使 T1/T2 偏小或失去可比性。
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
    const int64_t t1 = get_sys_cnt_safe();

    cycles[0] = t1 - t0;
    asc_sync();
}

// Host 侧按相同顺序计算 golden，保证两个 VF 调用均未破坏结果。
float expected_value(float b_value, float c_value)
{
#if SIMT_CASE == 1
    return b_value + c_value;
#else
    float value = b_value + c_value;
    value = value * value;
    value = b_value + value;
    value = value * value;
    value = c_value + value;
    return value;
#endif
}

bool nearly_equal(float actual, float expected)
{
    const float tolerance = 1.0e-6F + 1.0e-5F * std::fabs(expected);
    return std::fabs(actual - expected) <= tolerance;
}

int32_t main(int32_t argc, char* argv[])
{
    // 用法：simtvf_cycle_count [device_id] [samples]
    const int32_t device_id = argc > 1 ? std::atoi(argv[1]) : 0;
    const int32_t samples = argc > 2 ? std::atoi(argv[2]) : 21;

    if (device_id < 0 || samples <= 0) {
        std::cerr << "invalid device_id or samples" << std::endl;
        return 1;
    }

    const size_t data_bytes = DATA_SIZE * sizeof(float);
    const size_t cycle_bytes = CYCLE_COUNT * sizeof(int64_t);

    std::vector<float> a_host(DATA_SIZE, 0.0F);
    std::vector<float> b_host(DATA_SIZE);
    std::vector<float> c_host(DATA_SIZE);
    for (uint32_t i = 0; i < DATA_SIZE; ++i) {
        // 使用小幅、有限值，避免 Case 2 的平方链溢出，同时使各元素结果不同。
        b_host[i] = static_cast<float>(i % 17U + 1U) * 0.01F;
        c_host[i] = static_cast<float>(i % 11U + 1U) * 0.02F;
    }

    float* a_device = nullptr;
    float* b_device = nullptr;
    float* c_device = nullptr;
    int64_t* cycles_device = nullptr;
    int64_t cycles_host[CYCLE_COUNT] = {-1};

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtMalloc((void**)&a_device, data_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&b_device, data_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&c_device, data_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cycles_device, cycle_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(b_device, data_bytes, b_host.data(), data_bytes,
                ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(c_device, data_bytes, c_host.data(), data_bytes,
                ACL_MEMCPY_HOST_TO_DEVICE);

    std::cout << "sample,case,threads,data_size,vf_calls,total_cycles,correct"
              << std::endl;

    bool all_correct = true;
    for (int32_t sample = 0; sample < samples; ++sample) {
        cycles_host[0] = -1;
        aclrtMemcpy(cycles_device, cycle_bytes, cycles_host, cycle_bytes,
                    ACL_MEMCPY_HOST_TO_DEVICE);

        simtvf_cycle_count<<<NUM_BLOCKS, 0>>>(
            a_device, b_device, c_device, cycles_device);
        aclrtSynchronizeDevice();

        aclrtMemcpy(cycles_host, cycle_bytes, cycles_device, cycle_bytes,
                    ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(a_host.data(), data_bytes, a_device, data_bytes,
                    ACL_MEMCPY_DEVICE_TO_HOST);

        bool correct = cycles_host[0] > 0;
        for (uint32_t i = 0; i < DATA_SIZE && correct; ++i) {
            correct = nearly_equal(a_host[i], expected_value(b_host[i], c_host[i]));
        }
        all_correct = all_correct && correct;

        std::cout << sample << ',' << SIMT_CASE << ',' << SIMT_THREADS << ','
                  << DATA_SIZE << ',' << VF_CALLS << ',' << cycles_host[0] << ','
                  << correct << std::endl;
    }

    aclrtFree(a_device);
    aclrtFree(b_device);
    aclrtFree(c_device);
    aclrtFree(cycles_device);
    aclrtResetDevice(device_id);
    aclFinalize();

    return all_correct ? 0 : 2;
}
