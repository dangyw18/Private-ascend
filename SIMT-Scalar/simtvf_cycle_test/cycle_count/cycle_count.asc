/*
 * Measure the first SIMTVF call in a Vector kernel with the public clock()
 * timestamp API.
 *
 * cycles[0]: cold entry cycles, from the outer t0 to the first timestamp
 *            recorded by SIMT thread 0.
 * cycles[1]: total cycles, from the outer t0 until PIPE_V completes.
 */

#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/debug/asc_time.h"

#include "../simt_kernel/simt_kernel.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t CYCLE_COUNT = 2;

// Keep the two outer timestamp reads distinct at -O2/-O3.
__attribute__((noinline)) __aicore__ uint64_t clock_safe()
{
    return __asc_aicore::clock();
}

__vector__ __global__ void simtvf_cycle_count(
    __gm__ uint32_t* input, __gm__ uint32_t* output,
    __gm__ uint64_t* cycles, uint32_t workload_iters)
{
    asc_init();

    // This is the first and only VF call in the kernel.
    const uint64_t t0 = clock_safe();
    asc_vf_call<SimtKernel>(
        dim3{SIMT_THREADS, 1, 1}, input, output, cycles, t0, workload_iters);

    // The outer clock() read is PIPE_S.  Wait for SIMTVF/PIPE_V before t1.
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
    const uint64_t t1 = clock_safe();

    cycles[1] = t1 - t0;
    asc_sync();
}

uint32_t expected_value(uint32_t input, uint32_t tid, uint32_t workload_iters)
{
    uint32_t value = input;
    for (uint32_t i = 0; i < workload_iters; ++i) {
        value = value * 1664525U + 1013904223U + tid;
    }
    return value;
}

int32_t main(int32_t argc, char* argv[])
{
    // Usage: ./simtvf_cycle_count [device_id] [workload_iters] [samples]
    const int32_t device_id = argc > 1 ? std::atoi(argv[1]) : 0;
    const uint32_t workload_iters =
        argc > 2 ? static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 10)) : 0;
    const int32_t samples = argc > 3 ? std::atoi(argv[3]) : 30;

    if (device_id < 0 || samples <= 0) {
        std::cerr << "invalid device_id or samples" << std::endl;
        return 1;
    }

    const size_t data_bytes = SIMT_THREADS * sizeof(uint32_t);
    const size_t cycle_bytes = CYCLE_COUNT * sizeof(uint64_t);

    std::vector<uint32_t> input_host(SIMT_THREADS);
    std::vector<uint32_t> output_host(SIMT_THREADS);
    for (uint32_t i = 0; i < SIMT_THREADS; ++i) {
        input_host[i] = i + 1;
    }

    uint64_t cycles_host[CYCLE_COUNT] = {UINT64_MAX, UINT64_MAX};
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    uint64_t* cycles_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtMalloc((void**)&input_device, data_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, data_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cycles_device, cycle_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, data_bytes, input_host.data(), data_bytes,
                ACL_MEMCPY_HOST_TO_DEVICE);

    std::cout << "sample,threads,workload_iters,cold_entry_cycles,total_cycles,correct"
              << std::endl;

    bool all_correct = true;
    bool all_intervals_valid = true;
    for (int32_t sample = 0; sample < samples; ++sample) {
        cycles_host[0] = UINT64_MAX;
        cycles_host[1] = UINT64_MAX;
        aclrtMemcpy(cycles_device, cycle_bytes, cycles_host, cycle_bytes,
                    ACL_MEMCPY_HOST_TO_DEVICE);

        simtvf_cycle_count<<<NUM_BLOCKS, 0>>>(
            input_device, output_device, cycles_device, workload_iters);
        aclrtSynchronizeDevice();

        aclrtMemcpy(cycles_host, cycle_bytes, cycles_device, cycle_bytes,
                    ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(output_host.data(), data_bytes, output_device, data_bytes,
                    ACL_MEMCPY_DEVICE_TO_HOST);

        bool correct = true;
        for (uint32_t tid = 0; tid < SIMT_THREADS; ++tid) {
            if (output_host[tid] != expected_value(input_host[tid], tid, workload_iters)) {
                correct = false;
                break;
            }
        }
        const bool interval_valid = cycles_host[0] != UINT64_MAX &&
                                    cycles_host[1] != UINT64_MAX &&
                                    cycles_host[0] > 0 &&
                                    cycles_host[1] >= cycles_host[0];
        all_correct = all_correct && correct;
        all_intervals_valid = all_intervals_valid && interval_valid;

        std::cout << sample << ',' << SIMT_THREADS << ',' << workload_iters << ','
                  << cycles_host[0] << ',' << cycles_host[1] << ','
                  << (correct && interval_valid) << std::endl;
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFree(cycles_device);
    aclrtResetDevice(device_id);
    aclFinalize();

    return all_correct && all_intervals_valid ? 0 : 2;
}
